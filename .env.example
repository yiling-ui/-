# =============================================================================
# Altcoin Momentum Agent V1.0 -- Environment Variables
# =============================================================================
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Operating-mode hierarchy:
#   DRY_RUN=true              -> no orders, just structured logging.
#   PAPER_TRADE=true          -> real ccxt orders against the testnet/sandbox
#                                of the chosen exchange.
#   neither                   -> LIVE trading on mainnet. Requires API keys
#                                with trade scope.

# -----------------------------------------------------------------------------
# Operating mode
# -----------------------------------------------------------------------------

DRY_RUN=true
PAPER_TRADE=false
LOG_LEVEL=INFO

# Healthcheck port for /healthz (Docker maps this externally).
HEALTHZ_PORT=8080

# -----------------------------------------------------------------------------
# DeepSeek API (read by ai_engine.DeepSeekEngine and learning_engine)
# -----------------------------------------------------------------------------

# [SECRET] Required for AI verdicts and Learning-Engine post-mortems.
# If unset, system runs in rule-only mode and learning falls back to a
# heuristic feature picker.
DEEPSEEK_API_KEY=

# -----------------------------------------------------------------------------
# Learning engine (read by fuser.RuleIndex and learning_engine.RuleStore)
# -----------------------------------------------------------------------------

# Path to the learned-rules JSON. Default lives inside .kiro/steering/
DYNAMIC_RULES_JSON=/app/.kiro/steering/dynamic_rules.json

# -----------------------------------------------------------------------------
# Exchange API keys (read by main.py via build_ccxt_adapter)
# -----------------------------------------------------------------------------
# Use READ-ONLY keys + IP whitelisting whenever possible. For live trading
# use a SEPARATE key from your view-only key, restricted to "trade" only --
# DO NOT enable withdrawals.
#
# Only the key set for the FIRST entry in `exchanges:` (config/app.yaml)
# is consumed by main.py; the others are recognised here so you can prepare
# for a multi-venue rollout.

# Binance USDT-M Futures
# [SECRET]
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Set to "true" to use Binance Futures Testnet (no real funds at risk).
BINANCE_TESTNET=true

# OKX swap
# [SECRET]
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_TESTNET=true

# Gate.io USDT-M Futures
# [SECRET]
GATE_API_KEY=
GATE_API_SECRET=
GATE_TESTNET=true

# -----------------------------------------------------------------------------
# Binance Square scraping (PRIMARY social source)
# -----------------------------------------------------------------------------
# Capture from a logged-in browser session at binance.com:
#   DevTools -> Application -> Cookies -> copy the entire 'Cookie:' header.
# At minimum we need: csrftoken, bnc-uuid, p20t.
# Without these, the social aggregator gracefully degrades to public CMS
# announcements only (still useful, but no live Square posts).
BINANCE_SQUARE_COOKIE=

# -----------------------------------------------------------------------------
# Proxy pool for geo-blocked endpoints (HTTP 451)
# -----------------------------------------------------------------------------
# Comma-separated list. SOCKS5 supported when the `socks` extra is installed.
# Examples:
#   PROXY_POOL=http://user:pass@host1:8080,http://user:pass@host2:8080
#   PROXY_POOL=socks5://user:pass@vpn1:1080,socks5://user:pass@vpn2:1080
PROXY_POOL=
PROXY_ROTATE=true
