# =============================================================================
# Altcoin Momentum Agent V1.0 -- Environment Variables
# =============================================================================
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Only the variables below are READ BY THE CODE in V1.0. Variables for
# modules that are not yet wired into main.py (live exchange API keys,
# Binance Square cookies, proxy pool) are listed at the bottom under
# "Plumbing for live wiring (NOT YET CONSUMED BY main.py)" so you can
# drop them in without surprise once the live adapters land.

# -----------------------------------------------------------------------------
# Operating mode (read by main.py)
# -----------------------------------------------------------------------------

# DRY_RUN: when "true" (or 1/yes), main.py refuses to place real orders.
# Set in BOTH compose env and .env so docker-compose doesn't surprise you.
DRY_RUN=true

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Healthcheck port for /healthz (Docker maps this externally).
HEALTHZ_PORT=8080

# -----------------------------------------------------------------------------
# DeepSeek API (read by ai_engine.DeepSeekEngine and learning_engine)
# -----------------------------------------------------------------------------

# [SECRET] Required for AI verdicts and learning-engine post-mortems.
# If unset, system runs in rule-only mode and learning falls back to a
# heuristic feature picker.
DEEPSEEK_API_KEY=

# -----------------------------------------------------------------------------
# Learning engine (read by fuser.RuleIndex and learning_engine.RuleStore)
# -----------------------------------------------------------------------------

# Path to the learned-rules JSON. Default lives inside .kiro/steering/
# Override only if you mount the file elsewhere.
DYNAMIC_RULES_JSON=/app/.kiro/steering/dynamic_rules.json

# =============================================================================
# Plumbing for live wiring (NOT YET CONSUMED BY main.py in V1.0)
# =============================================================================
# These keys belong to modules whose code exists in this repo (binance_square
# scraper, risk executor protocol) but which are NOT yet wired into the V1.0
# daemon entry point. Setting them now is harmless. They will be picked up
# automatically when the matching wiring lands in a future PR.

# Binance USDT-M Futures (live trading -- READ-ONLY by V1.0)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# OKX swap (live trading -- READ-ONLY by V1.0)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_TESTNET=true

# Gate.io USDT-M Futures (live trading -- READ-ONLY by V1.0)
GATE_API_KEY=
GATE_API_SECRET=
GATE_TESTNET=true

# Binance Square scraping (PRIMARY social source).
# Capture from a logged-in browser session at binance.com:
#   DevTools -> Application -> Cookies -> copy the entire 'Cookie:' header.
# At minimum we need: csrftoken, bnc-uuid, p20t.
BINANCE_SQUARE_COOKIE=

# Proxy pool for geo-blocked endpoints (HTTP 451). Comma-separated.
# SOCKS5 supported when the `socks` extra is installed.
# Examples:
#   PROXY_POOL=http://user:pass@host1:8080,http://user:pass@host2:8080
#   PROXY_POOL=socks5://user:pass@vpn1:1080,socks5://user:pass@vpn2:1080
PROXY_POOL=
PROXY_ROTATE=true
