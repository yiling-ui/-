# =============================================================================
# Altcoin Momentum Agent V1.0 -- Environment Variables
# =============================================================================
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Operating-mode hierarchy:
#   DRY_RUN=true              -> no orders, just structured logging.
#   PAPER_TRADE=true          -> real ccxt orders against the testnet/sandbox
#                                of the chosen exchange.
#   neither                   -> LIVE trading on mainnet. Requires API keys
#                                with trade scope.

# -----------------------------------------------------------------------------
# Operating mode
# -----------------------------------------------------------------------------

DRY_RUN=true
PAPER_TRADE=false
LOG_LEVEL=INFO

# Healthcheck/dashboard port (Docker maps this externally).
HEALTHZ_PORT=8080

# Web dashboard at /dashboard. Set to "false" to disable.
DASHBOARD_ENABLED=true

# -----------------------------------------------------------------------------
# Dashboard / live-mode safety gates (Bug C1 + C5 fix)
# -----------------------------------------------------------------------------
# The dashboard exposes positions/orders/learnt-rules and is bound to
# 127.0.0.1 by default. To make it reachable from another host you MUST
# set DASHBOARD_TOKEN (otherwise the daemon refuses to start, fail-closed)
# and clients must send `X-Auth-Token: $DASHBOARD_TOKEN` on every request.
# Recommended: leave the bind on loopback and use an SSH tunnel
# (`ssh -L 8081:127.0.0.1:8081 host`).
# [SECRET]
DASHBOARD_TOKEN=

# Live-mode acknowledgement. When DRY_RUN=false AND PAPER_TRADE=false, the
# daemon refuses to start unless this is set to the literal string
# I_UNDERSTAND. Guards against accidental DRY_RUN=0 / typo / stale CI shell.
LIVE_CONFIRM=

# -----------------------------------------------------------------------------
# LLM provider (read by ai_engine.LLMEngine and learning_engine)
# -----------------------------------------------------------------------------

# Choose ONE backend. Default is "deepseek".
# Supported: deepseek | openai | openrouter | moonshot | qwen | anthropic | generic
LLM_PROVIDER=deepseek

# Provider-specific keys -- only the matching one is consumed.
# [SECRET]
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=

# For LLM_PROVIDER=generic only:
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=

# Optional: override the default model for the chosen provider.
# Examples:
#   LLM_MODEL=gpt-4o               (with LLM_PROVIDER=openai)
#   LLM_MODEL=deepseek-reasoner    (with LLM_PROVIDER=deepseek)

# -----------------------------------------------------------------------------
# Telegram notifier
# -----------------------------------------------------------------------------

# Set TG_ENABLED=true to receive structured cards on signal / open / reject /
# error events. Bot must already be a member of the target chat. Token from
# @BotFather, chat_id can be a channel ("@my_channel"), group ("-100..."),
# or DM (numeric user id).
TG_ENABLED=false
TG_BOT_TOKEN=
TG_CHAT_ID=
# TG_API_BASE=https://api.telegram.org

# -----------------------------------------------------------------------------
# Learning engine paths
# -----------------------------------------------------------------------------

DYNAMIC_RULES_JSON=/app/.kiro/steering/dynamic_rules.json

# -----------------------------------------------------------------------------
# Exchange API keys (read by main.py via build_ccxt_adapter)
# -----------------------------------------------------------------------------
# Use READ-ONLY keys + IP whitelisting whenever possible. For live trading
# use a SEPARATE key from your view-only key, restricted to "trade" only --
# DO NOT enable withdrawals.

# Binance USDT-M Futures
# [SECRET]
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Set to "true" to use Binance Futures Testnet (no real funds at risk).
BINANCE_TESTNET=true

# OKX swap
# [SECRET]
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_TESTNET=true

# Gate.io USDT-M Futures
# [SECRET]
GATE_API_KEY=
GATE_API_SECRET=
GATE_TESTNET=true

# -----------------------------------------------------------------------------
# Binance Square scraping (PRIMARY social source)
# -----------------------------------------------------------------------------
# Capture from a logged-in browser session at binance.com:
#   DevTools -> Application -> Cookies -> copy the entire 'Cookie:' header.
# At minimum we need: csrftoken, bnc-uuid, p20t.
# Without these, the social aggregator gracefully degrades to public CMS
# announcements only (still useful, but no live Square posts).
BINANCE_SQUARE_COOKIE=

# -----------------------------------------------------------------------------
# Proxy pool for geo-blocked endpoints (HTTP 451)
# -----------------------------------------------------------------------------
# Comma-separated list. SOCKS5 supported when the `socks` extra is installed.
# Examples:
#   PROXY_POOL=http://user:pass@host1:8080,http://user:pass@host2:8080
#   PROXY_POOL=socks5://user:pass@vpn1:1080,socks5://user:pass@vpn2:1080
PROXY_POOL=
PROXY_ROTATE=true
